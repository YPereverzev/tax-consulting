# Public site URL without a trailing slash. Used for metadata, sitemap, and canonicals.
NEXT_PUBLIC_SITE_URL=https://keinestressmitfinanzamt.de

# Cloudflare Turnstile. Dummy keys always pass and are for local development only:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend. Required in production. In development the API logs the request instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Yuri <noreply@example.com>"
CONSULT_TO_EMAIL=

# Shown in the footer and JSON-LD. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
